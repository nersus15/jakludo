# Port HTTP & Socket.IO
PORT=5172

# Set 1 jika berada di belakang Nginx / reverse proxy
TRUST_PROXY=0

# Konfigurasi Container PostgreSQL (dipakai oleh docker-compose.yml)
POSTGRES_USER=jakludo
POSTGRES_PASSWORD=ganti_password_kuat_ini
POSTGRES_DB=jakludo
# Port di localhost host server (default 5433 agar tidak bentrok dengan PostgreSQL lain di port 5432)
POSTGRES_PORT=5433

# URL Koneksi PostgreSQL untuk menjalankan Node secara lokal di luar Docker
# (Saat berjalan di Docker Compose, otomatis memakai host `postgres:5432` internal)
DATABASE_URL=postgresql://jakludo:ganti_password_kuat_ini@127.0.0.1:5433/jakludo
