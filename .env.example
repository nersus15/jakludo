# Port HTTP & Socket.IO
PORT=5172

# Set 1 jika berada di belakang Nginx / reverse proxy
TRUST_PROXY=0

# Konfigurasi Container PostgreSQL (dipakai oleh docker-compose.yml & aplikasi)
POSTGRES_USER=jakludo
POSTGRES_PASSWORD=ganti_password_kuat_ini
POSTGRES_DB=jakludo
# Port di localhost host server (default 5433 agar tidak bentrok dengan PostgreSQL lain di port 5432)
POSTGRES_PORT=5433
